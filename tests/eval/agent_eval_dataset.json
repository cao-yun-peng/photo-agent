        "pass_threshold": 0.9
      }
    },
    {
      "id": "TC-010",
      "dimension": "D3",
      "category": "query 参数构造",
      "priority": "P0",
      "difficulty": "easy",
      "user_query": "帮我找去年夏天在海边拍的照片",
      "context": {"photos_available": true, "matching_photos": ["p-003"]},
      "expected": {
        "expected_tools": ["search_photos", "final_answer"],
        "tool_order_strict": false,
        "must_not_call": [],
        "expected_final_status": "completed",
        "parameter_checks": {
          "search_photos.query": {"contains_any": ["海边", "夏天"]},
          "search_photos.from_date": {"equals": "2025-06-01"}
        }
      },
      "rubric": {
        "parameter_construction": "query 参数应保留语义关键词，from_date/to_date 应反映去年夏天",
        "pass_threshold": 0.7
      }
    },
    {
      "id": "TC-011",
      "dimension": "D3",
      "category": "photo_id 参数构造",
      "priority": "P0",
      "difficulty": "medium",
      "user_query": "把这张猫的照片变成宫崎骏风格",
      "context": {"photos_available": true, "confirmed_photo_id": "p-001", "last_search_items": [{"id": "p-001", "ai_description": "一只橘猫趴在窗台上晒太阳"}]},
      "expected": {
        "expected_tools": ["apply_skill", "final_answer"],
        "tool_order_strict": false,
        "must_not_call": ["search_photos"],
        "expected_final_status": "completed",
        "parameter_checks": {
          "apply_skill.photo_id": {"equals_photo_id": "p-001"}
        }
      },
      "rubric": {
        "parameter_construction": "photo_id 必须使用上下文中已确认的照片 ID，不能编造",
        "pass_threshold": 0.9
      }
    },
    {
