      "context": {"photos_available": true, "matching_photos": ["p-001"]},
      "expected": {
        "expected_tools": ["search_photos", "final_answer"],
        "tool_order_strict": false,
        "must_not_call": ["apply_skill"],
        "expected_final_status": "completed"
      },
      "rubric": {
