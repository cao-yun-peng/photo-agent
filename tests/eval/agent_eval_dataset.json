  "test_cases": [
    {
      "id": "TC-001",
      "dimension": "D1",
      "category": "搜索意图",
      "priority": "P0",
      "difficulty": "easy",
      "user_query": "帮我找一下猫的照片",
      "context": {"photos_available": true, "matching_photos": ["p-001"]},
      "expected": {
        "expected_tools": ["search_photos", "final_answer"],
        "tool_order_strict": false,
        "must_not_call": ["apply_skill"],
        "expected_final_status": "completed",
        "expected_result_contains": ["猫"]
      },
      "rubric": {
        "tool_selection": "必须调用 search_photos，不能跳过搜索直接回复",
        "intent_correct": "识别为搜索意图，不应调用 apply_skill",
        "final_answer": "回复中应包含找到的照片信息",
        "pass_threshold": 0.8
      }
    },
    {
      "id": "TC-002",
      "dimension": "D1",
      "category": "搜索意图",
      "priority": "P0",
      "difficulty": "easy",
      "user_query": "找去年在海边拍的照片",
      "context": {"photos_available": true, "matching_photos": ["p-003"]},
      "expected": {
        "expected_tools": ["search_photos", "final_answer"],
        "tool_order_strict": false,
        "must_not_call": ["apply_skill"],
        "expected_final_status": "completed",
        "expected_result_contains": ["海边"]
      },
      "rubric": {
        "tool_selection": "必须调用 search_photos，query 参数应包含海边相关描述",
        "parameter_construction": "可能附带 from_date/to_date 时间范围",
        "pass_threshold": 0.8
      }
    },
    {
      "id": "TC-003",
      "dimension": "D1",
      "category": "生成意图",
      "priority": "P0",
      "difficulty": "medium",
      "user_query": "帮我把那张猫的照片变成动漫风",
      "context": {"photos_available": true, "last_search_items": ["p-001"], "confirmed_photo_id": "p-001"},
      "expected": {
        "expected_tools": ["apply_skill", "final_answer"],
        "tool_order_strict": false,
        "must_not_call": ["search_photos"],
        "expected_final_status": "completed",
        "expected_result_contains": ["动漫", "生成"]
      },
      "rubric": {
        "intent_correct": "识别为生成意图，应调用 apply_skill 而非重新搜索",
        "parameter_construction": "photo_id 应为已确认的照片 ID",
        "pass_threshold": 0.8
      }
    },
    {
      "id": "TC-004",
      "dimension": "D1",
      "category": "闲聊意图",
      "priority": "P1",
      "difficulty": "easy",
      "user_query": "你好，你能做什么？",
      "context": {"photos_available": true},
      "expected": {
        "expected_tools": ["final_answer"],
        "tool_order_strict": false,
        "must_not_call": ["search_photos", "apply_skill", "fallback_search"],
        "expected_final_status": "completed",
        "expected_result_contains": ["照片", "搜索", "改造"]
      },
      "rubric": {
        "intent_correct": "识别为闲聊/介绍意图，不应调用任何搜索或生成工具",
        "final_answer": "回复应简要说明 Agent 的能力范围",
        "pass_threshold": 0.7
      }
    },
    {
      "id": "TC-005",
      "dimension": "D1",
      "category": "混合意图",
      "priority": "P1",
      "difficulty": "hard",
      "user_query": "找一下樱花的照片，然后帮我把它变成水彩画风格",
      "context": {"photos_available": true, "matching_photos": ["p-006"]},
      "expected": {
        "expected_tools": ["search_photos", "apply_skill", "final_answer"],
        "tool_order_strict": true,
        "must_not_call": [],
        "expected_final_status": "completed"
      },
      "rubric": {
        "multi_step": "应先搜索樱花照片，再用搜索结果中的 photo_id 调用 apply_skill",
        "tool_order": "search_photos 必须在 apply_skill 之前",
        "pass_threshold": 0.8
      }
    },
    {
      "id": "TC-006",
      "dimension": "D2",
      "category": "选择 search_photos",
      "priority": "P0",
      "difficulty": "easy",
      "user_query": "我之前拍过一张日式拉面的照片，帮我找找",
