        "tool_order_strict": false,
        "must_not_call": ["apply_skill"],
        "expected_final_status": "clarified",
        "expected_final_status_any_of": ["clarified", "completed"],
        "expected_result_contains_any": ["时间", "地点", "人物", "宠物", "类型", "场景", "哪一类", "什么样"],
        "expected_clarification": "初始查询完全没有具体线索，可调用 ask_clarification，也可用有效自然语言询问线索"
      },
      "rubric": {
        "clarification": "query 完全没有可搜索线索，应在搜索前用结构化或自然语言澄清",
        "clarification_options": "澄清选项应包含时间/地点/类型等维度",
        "pass_threshold": 0.7
      }
    },
