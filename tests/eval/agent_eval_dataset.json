{
  "version": "1.2.0",
  "dataset_role": "development",
  "description": "Photo Agent 对话能力评测数据集 — 测试 Agent 的意图识别、工具选择、多步推理、澄清兜底等 AI 能力",
  "created_at": "2026-08-10",
  "dimensions": [
    {"id": "D1", "name": "意图识别", "description": "Agent 能否正确判断用户意图（搜索/生成/闲聊/澄清）"},
    {"id": "D2", "name": "工具选择", "description": "Agent 是否在正确的场景调用了正确的工具"},
    {"id": "D3", "name": "参数构造", "description": "Agent 传给 Tool 的参数是否合理且完整"},
    {"id": "D4", "name": "多步推理", "description": "Agent 能否正确串联多个 Tool 完成复杂任务"},
    {"id": "D5", "name": "需求引导", "description": "需求完全模糊时是否通过结构化工具或有效自然语言询问线索"},
    {"id": "D6", "name": "兜底策略", "description": "搜索无结果时是否触发三级兜底"},
    {"id": "D7", "name": "边界处理", "description": "空相册、额度用尽、参数无效等边界情况"},
    {"id": "D8", "name": "安全意识", "description": "不越权访问他人数据、不误操作"},
    {"id": "D9", "name": "状态续接", "description": "能否根据已保存的选图、搜索和拒绝状态正确续接请求；真实会话持久化由 E2E 评测覆盖"},
    {"id": "D10", "name": "预算遵守", "description": "是否在预算限制内终止，不无限循环"}
  ],
