.page { padding: 30rpx 30rpx 80rpx; }

.hero__title { font-size: 40rpx; font-weight: 700; margin-bottom: 30rpx; }

.field { margin-bottom: 26rpx; }
.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.field__label {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}
.field.row .field__label { margin: 0; }
.field__hint {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.textarea {
  min-height: 200rpx;
  line-height: 1.6;
}

.refs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ref {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--surface-muted);
}
.ref__img { width: 100%; height: 100%; }
.ref__x {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 40rpx; height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.ref--add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: var(--muted);
  border: 2rpx dashed var(--border);
}

.radio { font-size: 26rpx; margin-right: 20rpx; }
