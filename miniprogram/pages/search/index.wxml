<view class="page">
  <view wx:if="{{parsed}}" class="parsed card">
    <view class="parsed__title">解析结果</view>
    <view class="parsed__row">
      <text class="tag tag--brand">语义：{{parsed.semantic}}</text>
    </view>
    <view wx:if="{{parsed.from_date}}" class="parsed__row">
      <text class="tag">时间：{{parsed.from_date}} ~ {{parsed.to_date}}</text>
    </view>
    <view wx:if="{{parsed.place}}" class="parsed__row">
      <text class="tag">地点：{{parsed.place}}</text>
    </view>
  </view>

  <view wx:if="{{results.length === 0 && !loading}}" class="empty">
    <view class="empty__title">和 Photo Agent 说说你想找什么</view>
    <view class="empty__hint">“上周西湖” · “夕阳” · “小橘” 都可以</view>
  </view>

  <view wx:if="{{results.length > 0}}" class="result-summary">
    {{resultMode === 'best' ? '最佳匹配 · 已从候选中选出 1 张' : 'Agent 找到的相关照片'}}
  </view>

  <view wx:if="{{results.length > 0}}" class="results">
    <block wx:for="{{results}}" wx:key="id">
      <view class="result card {{resultMode === 'best' ? 'result--best' : ''}}">
        <image class="result__thumb" src="{{item.thumb_url_full}}" mode="aspectFill" />
        <view class="result__body">
          <view class="result__desc">{{item.ai_description || '（还在处理）'}}</view>
          <view class="result__scores">
            <text class="tag">相关 {{item.score_semantic}}</text>
            <text class="tag">新鲜 {{item.score_recency}}</text>
            <text class="tag tag--brand">综合 {{item.score_final}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="chat-dock">
    <view class="chat-dock__header">
      <view class="chat-dock__title">
        <text class="chat-dock__dot"></text>
        Photo Agent
      </view>
      <view class="chat-dock__new" bindtap="onNewConversation">新对话</view>
    </view>

    <scroll-view
      class="chat-messages"
      scroll-y="{{true}}"
      scroll-into-view="{{chatScrollTarget}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
    >
      <view wx:if="{{chatMessages.length === 0}}" class="chat-welcome">
        输入一句话，我会帮你搜索、放宽条件或继续追问。
      </view>
      <block wx:for="{{chatMessages}}" wx:key="id">
        <view id="{{item.id}}" class="chat-row chat-row--{{item.role}}">
          <view class="chat-bubble chat-bubble--{{item.role}}">
            <view>{{item.text}}</view>
            <view wx:if="{{item.options.length > 0}}" class="clarification-options">
              <block wx:for="{{item.options}}" wx:for-item="option" wx:key="*this">
                <view
                  class="clarification-option"
                  bindtap="onTapClarificationOption"
                  data-option="{{option}}"
                >
                  {{option}}
                </view>
              </block>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{agentProgress}}" class="chat-row chat-row--assistant">
        <view class="chat-bubble chat-bubble--assistant chat-progress">{{agentProgress}}</view>
      </view>
    </scroll-view>

    <scroll-view class="chips" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <block wx:for="{{quickChips}}" wx:key="*this">
        <view
          class="chip {{activeChip === item ? 'chip--active' : ''}}"
          bindtap="onTapChip"
          data-chip="{{item}}"
        >
          {{item}}
        </view>
      </block>
    </scroll-view>

    <view class="chat-composer">
      <input
        class="chat-composer__input"
        placeholder="继续描述照片、时间、地点或人物"
        value="{{q}}"
        bindinput="onQChange"
        confirm-type="send"
        bindconfirm="onSearch"
        focus="{{searchInputFocused}}"
      />
      <view
        class="chat-composer__mic {{recording ? 'chat-composer__mic--rec' : ''}}"
        bindtouchstart="onVoiceStart"
        bindtouchend="onVoiceEnd"
      >
        🎤
      </view>
      <button class="chat-composer__send" bindtap="onSearch" loading="{{loading}}">发送</button>
    </view>
    <view class="chat-best" bindtap="onSearchBest">帮我从结果里选最好的一张</view>
  </view>
</view>
