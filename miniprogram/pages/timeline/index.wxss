.page { padding: 20rpx; }

.topbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 12rpx 30rpx;
}
.topbar__title { font-size: 40rpx; font-weight: 700; color: var(--ink); }
.topbar__hint { font-size: 24rpx; color: var(--muted); }

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
}
.cell {
  position: relative;
  width: 100%;
  padding-bottom: 100%;    /* 正方形 */
  background: var(--surface-muted);
  overflow: hidden;
  border-radius: 6rpx;
}
.cell__img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}
.cell__badge {
  position: absolute;
  bottom: 8rpx; right: 8rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
