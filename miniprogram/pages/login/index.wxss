.page {
  padding: 60rpx 40rpx;
}
.hero {
  text-align: center;
  margin-bottom: 60rpx;
}
.hero__title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}
.hero__sub {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.form__label {
  font-size: 26rpx;
  color: var(--muted);
  margin: 24rpx 0 12rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  background: var(--surface-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid var(--border);
}
.avatar::after { border: none; }
.avatar__img { width: 100%; height: 100%; }
.avatar__hint { font-size: 22rpx; color: var(--muted); }

.policy {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 32rpx;
  line-height: 1.6;
}
