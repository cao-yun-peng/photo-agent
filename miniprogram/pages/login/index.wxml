<view class="page">
  <view class="hero">
    <view class="hero__title">photo-agent</view>
    <view class="hero__sub">中文语义搜索的私人照片管家</view>
  </view>

  <view class="form card">
    <view class="form__label">头像（可选）</view>
    <button
      class="avatar"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <image
        wx:if="{{avatarUrl}}"
        class="avatar__img"
        src="{{avatarUrl}}"
        mode="aspectFill"
      />
      <text wx:else class="avatar__hint">点击选择头像</text>
    </button>

    <view class="form__label">昵称（可选）</view>
    <input
      class="input"
      type="nickname"
      placeholder="请输入昵称"
      value="{{nickname}}"
      bindchange="onNicknameChange"
    />

    <button
      class="btn btn--block"
      style="margin-top: 40rpx;"
      bindtap="onLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      使用微信登录
    </button>

    <view class="policy">
      登录即表示同意《服务协议》与《隐私政策》。开发环境下昵称头像可留空。
    </view>
  </view>
</view>
