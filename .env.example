# ============ App ============
APP_NAME=photo-agent
APP_ENV=dev                       # dev | prod
LOG_LEVEL=INFO
LOG_DIR=                          # 日志文件目录，空则仅输出到控制台
LOG_JSON_FORMAT=false             # dev环境用彩色控制台，生产环境设为true用JSON

# ============ Observability (OpenTelemetry / Grafana) ============
OTEL_ENABLED=false                # docker compose 联调/生产设为 true
OTEL_SERVICE_NAME=                # compose 会分别覆盖 api / worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACE_SAMPLE_RATIO=1.0       # 流量增大后建议按环境调整，错误链路由后端保留
OTEL_EXPORT_LOGS=true
OTEL_CAPTURE_CONTENT=false        # 禁止采集问题、prompt、回复、图片内容
OTEL_EXCLUDED_URLS=/live,/health,/ready,/docs,/openapi.json
GRAFANA_ADMIN_PASSWORD=admin      # 生产必须修改

# ============ Database ============
# 开发环境（docker compose 内网）
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/photo_agent
DB_PASSWORD=changeme

# ============ Redis ============
REDIS_URL=redis://redis:6379/0

# ============ JWT ============
# 生产环境用 openssl rand -hex 32 生成
JWT_SECRET=please_change_me_to_a_32_byte_random_string
JWT_EXPIRE_MINUTES=10080          # 7 天

# ============ WeChat MiniProgram ============
WECHAT_APPID=wx_your_appid
WECHAT_SECRET=your_secret

# ============ Aliyun OSS ============
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=photo-agent-dev
OSS_KEY_ID=LTAI_xxx
OSS_KEY_SECRET=xxx
OSS_UPLOAD_TTL=900                # 直传 URL 有效期（秒）

# ============ DashScope (Qwen VL / Embedding / Chat) ============
# 获取方式:
#   1. 登录 https://dashscope.console.aliyun.com/
#   2. 左侧 "API-KEY 管理" → 创建新的 API-KEY
#   3. 把 sk-xxxxxxxxxx 粘贴到下面 DASHSCOPE_API_KEY
# 保持 sk-xxx 则 worker 走 mock 分支（描述固定为占位文案）
DASHSCOPE_API_KEY=sk-xxx
# 默认工作区可使用公共地址；子工作区或海外地域按控制台文档填写专属地址
DASHSCOPE_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 可选：仅用于 gen_photo 下的测试图片生成脚本。禁止把真实密钥写入源码。
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
# PHOTO_TEST_OUTPUT_DIR=E:/project/agent/photo-agent/test_photos
QWEN_VL_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
AGENT_SEARCH_CANDIDATE_POOL_SIZE=12
AGENT_SEARCH_VISUAL_FALLBACK=true
AGENT_SEARCH_AUTO_REPAIR_INDEX=true
AGENT_SEARCH_INDEX_REPAIR_LIMIT=10
AGENT_SEARCH_TURN_BUDGET_SECONDS=12
AGENT_SEARCH_VISUAL_BUDGET_SECONDS=30
AGENT_SEARCH_PREFETCH_WAIT_SECONDS=2
AGENT_SEARCH_POOL_TTL_SECONDS=600
# Agent 决策用的文本模型，需支持 function calling
QWEN_CHAT_MODEL=qwen-plus
# Agent 单会话累计输入+输出 Token 预算；单次模型输出仍限制为 800。
AGENT_MAX_TOTAL_TOKENS=20000
WORKER_MAX_JOBS=4
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_RETRY_DELAYS_SECONDS=[2,8,25,60]
CB_EMBEDDING_RECOVERY_INTERVAL=30

# Top-K 查询-候选判同重排（模型留空时复用 QWEN_CHAT_MODEL）
SEARCH_RERANK_ENABLED=true
SEARCH_RERANK_MODEL=
SEARCH_RERANK_TOP_K=5
SEARCH_RERANK_REJECT_CONFIDENCE=0.8
SEARCH_RERANK_REQUIRE_MATCH=true
SEARCH_RERANK_TIMEOUT_SECONDS=12
SEARCH_RERANK_CACHE_TTL_SECONDS=604800
# 0=关闭全局硬阈值；完成线上标定后可设置 0~1。集合搜索始终绕过该阈值。
SEARCH_SEMANTIC_MIN_SCORE=0
CB_SEARCH_RERANK_RECOVERY_INTERVAL=120

# 二次视觉判定：只在文本判同无匹配但有不确定项，或细粒度查询 Top-2 近分时触发。
# 建议先在 development/validation 测通，再在生产环境打开。
SEARCH_VISUAL_VERIFY_ENABLED=false
SEARCH_VISUAL_VERIFY_TOP_K=3
SEARCH_VISUAL_VERIFY_SCORE_GAP=0.05
SEARCH_VISUAL_VERIFY_TIMEOUT_SECONDS=45
SEARCH_VISUAL_VERIFY_CACHE_TTL_SECONDS=604800
SEARCH_VISUAL_VERIFY_IMAGE_URL_TTL_SECONDS=300
CB_SEARCH_VISUAL_VERIFY_RECOVERY_INTERVAL=180

# ============ OpenAI (可选，用于 gpt-image-2 / Agent function calling) ============
# 不填就只能用万相；填了用户在 Skill 里可以选 model=gpt-image-2
OPENAI_API_KEY=sk-openai-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ============ 生图限流 ============
GEN_DAILY_FREE_QUOTA=3
GENERATION_CONFIRMATION_TTL_SECONDS=600
GENERATION_ESTIMATED_COST_YUAN=0.14
AGENT_V2_ENABLED=false
AGENT_V2_ROLLOUT_PERCENT=0
AGENT_V2_ROLLOUT_SALT=photo-agent-v2
AGENT_V2_KILL_SWITCH=false
